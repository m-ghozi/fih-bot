# Token bot Discord (ambil dari https://discord.com/developers/applications)
DISCORD_TOKEN=

# Opsional: isi ID server untuk sinkronisasi command instan saat development.
# Kosongkan untuk command global (bisa butuh beberapa menit tersedia).
GUILD_ID=

# Opsional: override endpoint wiki (default sudah benar).
WIKI_API_URL=https://fischipedia.org/w/api.php
WIKI_BASE_URL=https://fischipedia.org/wiki/

# User-Agent yang sopan. Ganti dengan info kontak kamu.
WIKI_USER_AGENT=FischWikiBot/1.0 (+https://github.com/username/fih-bot)
