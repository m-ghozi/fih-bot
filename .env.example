# Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=

# Optional: set a server ID to sync commands instantly during development.
# Leave empty for global commands (may take a few minutes to appear).
GUILD_ID=

# Optional: override the wiki endpoints (the defaults are correct).
WIKI_API_URL=https://fischipedia.org/w/api.php
WIKI_BASE_URL=https://fischipedia.org/wiki/

# A polite User-Agent. Replace with your own contact info.
WIKI_USER_AGENT=FischWikiBot/1.0 (+https://github.com/username/fih-bot)

# Optional logging. Under systemd logs go to journald; set LOG_FILE to also
# write a rotating file (5 MB, 3 backups).
LOG_LEVEL=INFO
LOG_FILE=
