[Unit]
Description=Fisch Wiki Discord Bot
Documentation=https://github.com/m-ghozi/fih-bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/.venv/bin/python -u run.py
Environment=PYTHONUNBUFFERED=1
Environment=LOG_LEVEL=INFO
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fih-bot

[Install]
WantedBy=default.target
